# 腾讯云开发 CloudBase 云托管环境变量示例
# 只提交本示例，不要提交真实值。

# 腾讯云 MySQL 公网连接串。
# CloudBase 无法接入 VPC 时，使用 MySQL 控制台开启的公网地址和端口。
# 例如：mysql://用户名:密码@公网地址:3306/数据库名
# 请在 MySQL 侧配置强密码、访问控制和允许的来源范围。
DATABASE_URL=

# 图片使用 CloudBase 挂载的 COS/FUSE 文件系统。
# 在 CloudBase 中把 COS/FUSE 挂载到 /data。
STORAGE_DRIVER=fuse
DATA_DIR=/data
UPLOADS_DIR=/data/uploads

# 主厨认证和无状态会话；必须使用稳定且不可猜测的值。
CHEF_PASSWORD=
SESSION_SECRET=

# 服务器端调用通义千问。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-vl-plus
OPENAI_RECIPE_MODEL=

# 微信分享和 HTTPS 绝对链接。
PUBLIC_APP_URL=
