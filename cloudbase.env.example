# 腾讯云开发 CloudBase 云托管环境变量示例
# 只提交本示例，不要提交真实值。

# 腾讯云 MySQL 连接串。
# 云托管中应填写 MySQL 内网地址和端口，例如：
# mysql://用户名:密码@内网地址:3306/数据库名
# 同时在 CloudBase 服务中开启私有网络，并配置 VPC、子网及 MySQL 白名单/安全组。
DATABASE_URL=

# 云版图片存储目标；不要把 COS/FUSE 挂载当作 SQLite 数据库。
STORAGE_DRIVER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 可选：图片公开访问域名；留空时由应用生成受保护的访问地址。
COS_PUBLIC_BASE_URL=

# 主厨认证和无状态会话；必须使用稳定且不可猜测的值。
CHEF_PASSWORD=
SESSION_SECRET=

# 服务器端调用通义千问。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-vl-plus
OPENAI_RECIPE_MODEL=

# 微信分享和 HTTPS 绝对链接。
PUBLIC_APP_URL=
