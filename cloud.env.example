# 镜像版本：留空默认 latest，可填 1.0.0 或 sha-完整提交号以固定/回退。
IMAGE_TAG=latest

# 腾讯云轻量应用服务器 Docker 配置示例。复制为 .env 后填写真实值，勿提交。
APP_PORT=3000
CLOUD_DATA_PATH=/data
CLOUD_BACKUP_PATH=/backups

# 直接用公网 HTTP:3000 时填 http://你的公网IP:3000；使用 Caddy/Nginx HTTPS 时填 https://你的域名。
# 留空则按请求中的 host 与 X-Forwarded-Proto 自动生成分享地址。
PUBLIC_ORIGIN=

# 可选：留空可直接进入后台；填写至少 10 位密码后启用登录保护。
CHEF_PASSWORD=
SESSION_SECRET=

# 阿里云百炼 MaaS / DashScope 兼容接口；只保存在云服务器环境变量中。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3-vl-plus
OPENAI_RECIPE_MODEL=

# 云服务器默认以 root 运行，避免宿主机挂载目录和 Next 缓存权限冲突。
PUID=0
PGID=0
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24
